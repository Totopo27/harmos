{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MaxObjectIntermediateRepresentation",
  "description": "Esquema universal de Representación Intermedia (IR) para objetos de Max MSP.",
  "type": "object",
  "required": ["object_name", "category", "target_runtime", "inlets", "outlets"],
  "properties": {
    "object_name": {
      "type": "string",
      "description": "Nombre canónico del objeto en Max (ej. wilson.core, wilson.hexslider)"
    },
    "category": {
      "type": "string",
      "enum": ["control", "dsp", "ui", "data_structure"]
    },
    "archetype_reference": {
      "type": "string",
      "description": "Objeto nativo de Max tomado como arquetipo funcional (ej. kslider, dict, coll, expr)"
    },
    "target_runtime": {
      "type": "string",
      "enum": ["c_classic", "cpp_min_devkit", "node_for_max", "js_painter_v8"]
    },
    "thread_safety": {
      "type": "string",
      "enum": ["main_thread_only", "scheduler_thread", "audio_dsp_perform"]
    },
    "inlets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string", "enum": ["int", "float", "symbol", "list", "anything", "signal"] },
          "description": { "type": "string" }
        }
      }
    },
    "outlets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string", "enum": ["int", "float", "symbol", "list", "anything", "signal"] },
          "description": { "type": "string" }
        }
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default": {},
          "description": { "type": "string" }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "arguments": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "data_tables": {
      "type": "array",
      "description": "Tablas de consulta de datos (afinaciones, constantes, buffers, colls)",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["coll", "buffer", "dict"] },
          "source_file": { "type": "string" },
          "total_entries": { "type": "integer" },
          "default_entry": { "type": "string" }
        }
      }
    },
    "control_interfaces": {
      "type": "array",
      "description": "Controles de usuario y conmutadores de estado vinculados al grafo de control",
      "items": {
        "type": "object",
        "required": ["name", "ui_type", "target_table"],
        "properties": {
          "name": { "type": "string" },
          "ui_type": { "type": "string", "enum": ["umenu", "radiogroup", "tab"] },
          "target_table": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "math_kernels": {
      "type": "array",
      "description": "Kernels matemáticos auxiliares en tiempo real (ej. scripts JS o gen~)",
      "items": {
        "type": "object",
        "required": ["name", "runtime", "source_file"],
        "properties": {
          "name": { "type": "string" },
          "runtime": { "type": "string", "enum": ["js", "gen", "c_external"] },
          "source_file": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
