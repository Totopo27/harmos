{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MaxObjectContractRules",
  "description": "Especificación estricta de contratos de entradas y salidas de Max MSP para generación dinámica sin hardcoding.",
  "objects": {
    "cycle~": {
      "inlets": {
        "0": { "name": "frequency_hz_or_phase", "type": "signal" },
        "1": { "name": "phase_offset", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "audio_out", "type": "signal" }
      }
    },
    "gain~": {
      "inlets": {
        "0": { "name": "audio_in", "type": "signal" },
        "1": { "name": "gain_control", "type": "int" }
      },
      "outlets": {
        "0": { "name": "audio_out", "type": "signal" }
      }
    },
    "ezdac~": {
      "inlets": {
        "0": { "name": "audio_left", "type": "signal" },
        "1": { "name": "audio_right", "type": "signal" }
      },
      "outlets": []
    },
    "notein": {
      "inlets": {
        "0": { "name": "midi_port_or_poll", "type": "int" }
      },
      "outlets": {
        "0": { "name": "pitch", "type": "int" },
        "1": { "name": "velocity", "type": "int" },
        "2": { "name": "channel", "type": "int" }
      }
    },
    "midiformat": {
      "inlets": {
        "0": { "name": "pitch", "type": "int", "range": [0, 127] },
        "1": { "name": "velocity", "type": "int", "range": [0, 127] },
        "2": { "name": "poly_aftertouch", "type": "int", "range": [0, 127] },
        "3": { "name": "control_change", "type": "list", "format": "[cc_num, value]" },
        "4": { "name": "program_change", "type": "int", "range": [1, 128] },
        "5": { "name": "pitch_bend", "type": "int", "range": [0, 16383], "center": 8192 },
        "6": { "name": "channel", "type": "int", "range": [1, 16] }
      },
      "outlets": {
        "0": { "name": "midi_raw_bytes", "type": "int" }
      }
    },
    "makenote": {
      "inlets": {
        "0": { "name": "pitch", "type": "int" },
        "1": { "name": "velocity", "type": "int" },
        "2": { "name": "duration_ms", "type": "int" }
      },
      "outlets": {
        "0": { "name": "pitch_out", "type": "int" },
        "1": { "name": "velocity_out", "type": "int" }
      }
    },
    "micro.mpe": {
      "inlets": {
        "0": { "name": "frequency_hz", "type": "float" },
        "1": { "name": "velocity", "type": "int" }
      },
      "outlets": {
        "0": { "name": "midi_note_list", "type": "list", "format": "[pitch, velocity, channel]" },
        "1": { "name": "channel_assigned", "type": "int" },
        "2": { "name": "cents_deviation", "type": "float" }
      }
    },
    "scale": {
      "inlets": {
        "0": { "name": "input_value", "type": "float" },
        "1": { "name": "in_low", "type": "float" },
        "2": { "name": "in_high", "type": "float" },
        "3": { "name": "out_low", "type": "float" },
        "4": { "name": "out_high", "type": "float" }
      },
      "outlets": {
        "0": { "name": "scaled_output", "type": "float" }
      }
    },
    "mtof": {
      "inlets": {
        "0": { "name": "midi_pitch", "type": "float" }
      },
      "outlets": {
        "0": { "name": "frequency_hz", "type": "float" }
      }
    },
    "ftom": {
      "inlets": {
        "0": { "name": "frequency_hz", "type": "float" }
      },
      "outlets": {
        "0": { "name": "midi_pitch", "type": "float" }
      }
    },
    "clip": {
      "inlets": {
        "0": { "name": "input_value", "type": "float" },
        "1": { "name": "min_value", "type": "float" },
        "2": { "name": "max_value", "type": "float" }
      },
      "outlets": {
        "0": { "name": "clipped_output", "type": "float" }
      }
    },
    "split": {
      "inlets": {
        "0": { "name": "input_value", "type": "float" },
        "1": { "name": "low_bound", "type": "float" },
        "2": { "name": "high_bound", "type": "float" }
      },
      "outlets": {
        "0": { "name": "inside_range", "type": "float" },
        "1": { "name": "outside_range", "type": "float" }
      }
    },
    "route": {
      "inlets": {
        "0": { "name": "input_message", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "matched_args", "type": "anything" },
        "1": { "name": "unmatched_pass", "type": "anything" }
      }
    },
    "unpack": {
      "inlets": {
        "0": { "name": "input_list", "type": "list" }
      },
      "outlets": {
        "0": { "name": "element_0", "type": "anything" }
      }
    },
    "clip~": {
      "inlets": {
        "0": { "name": "audio_in", "type": "signal" },
        "1": { "name": "min_bound", "type": "float" },
        "2": { "name": "max_bound", "type": "float" }
      },
      "outlets": {
        "0": { "name": "audio_out", "type": "signal" }
      }
    },
    "lores~": {
      "inlets": {
        "0": { "name": "audio_in", "type": "signal" },
        "1": { "name": "cutoff_freq_hz", "type": "float" },
        "2": { "name": "resonance_factor", "type": "float" }
      },
      "outlets": {
        "0": { "name": "audio_out", "type": "signal" }
      }
    },
    "*~": {
      "inlets": {
        "0": { "name": "audio_in_a", "type": "signal" },
        "1": { "name": "audio_in_b_or_gain", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "multiplied_audio", "type": "signal" }
      }
    },
    "+~": {
      "inlets": {
        "0": { "name": "audio_in_a", "type": "signal" },
        "1": { "name": "audio_in_b_or_offset", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "summed_audio", "type": "signal" }
      }
    },
    "-~": {
      "inlets": {
        "0": { "name": "audio_in_a", "type": "signal" },
        "1": { "name": "audio_in_b", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "subtracted_audio", "type": "signal" }
      }
    },
    "phasor~": {
      "inlets": {
        "0": { "name": "frequency_hz", "type": "signal" },
        "1": { "name": "phase_reset", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "phase_ramp", "type": "signal" }
      }
    },
    "saw~": {
      "inlets": {
        "0": { "name": "frequency_hz", "type": "signal" },
        "1": { "name": "phase_offset", "type": "float" }
      },
      "outlets": {
        "0": { "name": "audio_out", "type": "signal" }
      }
    },
    "rect~": {
      "inlets": {
        "0": { "name": "frequency_hz", "type": "signal" },
        "1": { "name": "duty_cycle", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "audio_out", "type": "signal" }
      }
    },
    "adsr~": {
      "inlets": {
        "0": { "name": "gate_trigger", "type": "signal" },
        "1": { "name": "attack_time_ms", "type": "float" },
        "2": { "name": "decay_time_ms", "type": "float" },
        "3": { "name": "sustain_gain", "type": "float" },
        "4": { "name": "release_time_ms", "type": "float" }
      },
      "outlets": {
        "0": { "name": "envelope_signal", "type": "signal" },
        "1": { "name": "envelope_completed_bang", "type": "bang" }
      }
    },
    "line~": {
      "inlets": {
        "0": { "name": "target_and_time_list", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "ramp_signal", "type": "signal" },
        "1": { "name": "ramp_completed_bang", "type": "bang" }
      }
    },
    "curve~": {
      "inlets": {
        "0": { "name": "target_time_curve_list", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "ramp_signal", "type": "signal" },
        "1": { "name": "ramp_completed_bang", "type": "bang" }
      }
    },
    "omx.peaklim~": {
      "inlets": {
        "0": { "name": "audio_left", "type": "signal" },
        "1": { "name": "audio_right", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "limited_left", "type": "signal" },
        "1": { "name": "limited_right", "type": "signal" }
      }
    },
    "in~": {
      "inlets": {
        "0": { "name": "signal_input", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "signal_output", "type": "signal" }
      }
    },
    "out~": {
      "inlets": {
        "0": { "name": "signal_input", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "signal_output", "type": "signal" }
      }
    },
    "thispoly~": {
      "inlets": {
        "0": { "name": "mute_or_voice_messages", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "voice_index", "type": "int" }
      }
    },
    "poly~": {
      "inlets": {
        "0": { "name": "target_voice_or_messages", "type": "anything" },
        "1": { "name": "audio_or_signal_in", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "audio_out_1", "type": "signal" },
        "1": { "name": "audio_out_2", "type": "signal" }
      }
    },
    "plugin~": {
      "inlets": [],
      "outlets": {
        "0": { "name": "audio_left", "type": "signal" },
        "1": { "name": "audio_right", "type": "signal" }
      }
    },
    "plugout~": {
      "inlets": {
        "0": { "name": "audio_left", "type": "signal" },
        "1": { "name": "audio_right", "type": "signal" }
      },
      "outlets": []
    },
    "in": {
      "inlets": {
        "0": { "name": "control_input", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "control_output", "type": "anything" }
      }
    },
    "out": {
      "inlets": {
        "0": { "name": "control_input", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "control_output", "type": "anything" }
      }
    },
    "sig~": {
      "inlets": {
        "0": { "name": "number_or_signal", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "signal_out", "type": "signal" }
      }
    },
    "tri~": {
      "inlets": {
        "0": { "name": "frequency_hz", "type": "signal" },
        "1": { "name": "duty_cycle", "type": "signal" }
      },
      "outlets": {
        "0": { "name": "audio_out", "type": "signal" }
      }
    },
    "coll": {
      "inlets": {
        "0": { "name": "address_or_message", "type": "anything" },
        "1": { "name": "store_data", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "entry_data", "type": "anything" },
        "1": { "name": "index_or_key", "type": "anything" },
        "2": { "name": "dump_out", "type": "anything" }
      }
    },
    "buffer~": {
      "inlets": {
        "0": { "name": "buffer_messages", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "buffer_completed_bang", "type": "bang" }
      }
    },
    "js": {
      "inlets": {
        "0": { "name": "js_inlet_0", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "js_outlet_0", "type": "anything" }
      }
    },
    "midiparse": {
      "inlets": {
        "0": { "name": "raw_midi_in", "type": "int" }
      },
      "outlets": {
        "0": { "name": "note_pitch_vel_list", "type": "list" },
        "1": { "name": "poly_aftertouch", "type": "list" },
        "2": { "name": "control_change", "type": "list" },
        "3": { "name": "program_change", "type": "int" },
        "4": { "name": "aftertouch", "type": "int" },
        "5": { "name": "pitchbend", "type": "int" },
        "6": { "name": "midi_channel", "type": "int" }
      }
    },
    "pack": {
      "inlets": {
        "0": { "name": "item_0", "type": "anything" },
        "1": { "name": "item_1", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "packed_list", "type": "list" }
      }
    },
    "prepend": {
      "inlets": {
        "0": { "name": "input_message", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "prepended_message", "type": "anything" }
      }
    },
    "trigger": {
      "inlets": {
        "0": { "name": "input_value", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "outlet_right", "type": "anything" },
        "1": { "name": "outlet_left", "type": "anything" }
      }
    },
    "t": {
      "inlets": {
        "0": { "name": "input_value", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "outlet_right", "type": "anything" },
        "1": { "name": "outlet_left", "type": "anything" }
      }
    },
    "loadmess": {
      "inlets": {
        "0": { "name": "bang_or_input", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "startup_message", "type": "anything" }
      }
    },
    "umenu": {
      "inlets": {
        "0": { "name": "menu_choice_or_message", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "item_index", "type": "int" },
        "1": { "name": "item_text", "type": "anything" }
      }
    },
    "message": {
      "inlets": {
        "0": { "name": "trigger_or_set_message", "type": "anything" }
      },
      "outlets": {
        "0": { "name": "message_out", "type": "anything" }
      }
    },
    "tet.inversion": {
      "inlets": {
        "0": { "name": "index_sum", "type": "int", "range": [0, 71] },
        "1": { "name": "divisions", "type": "int", "range": [3, 72] }
      },
      "outlets": {
        "0": { "name": "pairs_list", "type": "list", "format": "[i, partner, ...]" },
        "1": { "name": "fixed_points", "type": "list", "format": "[fixed_note...]" },
        "2": { "name": "symmetry_count", "type": "int" }
      }
    }
  }
}
